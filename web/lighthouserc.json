{
  "ci": {
    "collect": {
      "staticDistDir": "out",
      "url": [
        "http://localhost/index.html",
        "http://localhost/trends/index.html",
        "http://localhost/forecast-comparison/index.html",
        "http://localhost/methodology/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "first-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-report"
    }
  }
}
