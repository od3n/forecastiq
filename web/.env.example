# ─────────────────────────────────────────────────────────────────────
# ForecastIQ dashboard (web/) — browser environment (Next.js NEXT_PUBLIC_*).
# Copy to .env.local for local development. Only browser-SAFE values belong
# here: the Supabase anon key is RLS-scoped and public by design
# (docs/security/04-secrets-management.md). NEVER put the service-role key here.
# ─────────────────────────────────────────────────────────────────────

# ForecastIQ API base URL. Defaults to a relative /api/v1 (same-origin dev
# proxy); in production point at the API origin (Caddy-proxied).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Supabase Auth (S-08; ADR-008). Browser-safe public config. When unset (local
# dev without a Supabase project), /auth/signin offers a dev-token sign-in that
# is verified against the Go API (devauth); the other auth screens render a
# "not configured" notice instead of calling the SDK.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
