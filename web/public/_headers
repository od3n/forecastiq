# Cloudflare Pages response headers for the ForecastIQ dashboard (static export).
# Reference: docs/security/02-threat-model.md §2 (CSP limits XSS); ADR-033
# (Pages owns dashboard headers — there is no origin Caddy).
#
# NOTE: Pages `_headers` is static (no env interpolation). Replace the
# api/auth origins below with the real production values before first deploy.
# connect-src must list every origin the SPA calls: the API and Supabase auth.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Next.js static export injects inline <style>; recharts renders inline SVG.
  # script-src stays 'self' (no inline scripts in the export).
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://forecastiq-api.od3n.com https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
