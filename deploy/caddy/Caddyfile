# ForecastIQ — Caddy reverse proxy configuration
# Deployed to /etc/caddy/Caddyfile on the production VPS.
#
# Reference: docs/architecture/06-deployment-architecture.md §8
# Reference: docs/security/04-secrets-management.md (no secrets in this file)
#
# Caddy auto-manages TLS certificates via Let's Encrypt (ACME).
# The served domain comes from the FIQ_DOMAIN environment variable, set via
# the systemd drop-in written by deploy/bootstrap.sh (caddy.service.d) — the
# repo file is deployed verbatim on every release, so it must not hardcode a
# placeholder domain (DRB-WP23-007).

{$FIQ_DOMAIN:api.forecastiq.example} {
    reverse_proxy localhost:8080

    encode gzip

    # Security headers (NFR-SEC09)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "0"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Access log (JSON for grafana-agent ingestion)
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}
