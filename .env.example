# ─────────────────────────────────────────────────────────────────────
# ForecastIQ — environment configuration (12-factor)
# Copy to .env.local for local development. NEVER commit real secrets.
# The application validates these at startup and fails fast on invalid
# values (see internal/platform/config).
# ─────────────────────────────────────────────────────────────────────

# Runtime environment: development | test | production
FIQ_ENV=development

# Run mode for the single binary: api | worker | all
FIQ_MODE=all

# HTTP server
FIQ_HTTP_ADDR=0.0.0.0:8080
# Metrics server (Prometheus). Bound to localhost by default — the scrape
# agent runs on the same host. Set to the main addr to expose publicly.
FIQ_METRICS_ADDR=127.0.0.1:9090
FIQ_HTTP_READ_TIMEOUT=10s
FIQ_HTTP_WRITE_TIMEOUT=30s
FIQ_HTTP_SHUTDOWN_TIMEOUT=30s

# Logging: debug | info | warn | error ; format: json | text
FIQ_LOG_LEVEL=info
FIQ_LOG_FORMAT=json

# Database (PostgreSQL 16). Secret — keep out of version control.
FIQ_DATABASE_URL=postgres://forecastiq:forecastiq@localhost:5432/forecastiq?sslmode=disable
FIQ_DB_MAX_CONNS=20
FIQ_DB_MIN_CONNS=2
FIQ_DB_MAX_CONN_LIFETIME=1h

# Apply pending migrations automatically on startup (api/worker boot).
FIQ_AUTO_MIGRATE=true

# Raw payload store. Scheme-prefixed keys (ADR-011/019); MVP filesystem.
FIQ_PAYLOAD_STORE_DIR=./data/payloads

# Provider credentials — referenced by name (credential_ref), never the
# secret value, in the database (BR-08). Open-Meteo needs no key at MVP.
# FIQ_PROVIDER_OPENMETEO_API_KEY=
# FIQ_PROVIDER_OPENWEATHER_API_KEY=

# Provider request tuning
FIQ_PROVIDER_TIMEOUT=10s
FIQ_PROVIDER_MAX_RESPONSE_BYTES=10485760
# OpenWeather (WP-07) daily call budget per UTC day; the adapter pauses on a
# 429 and refuses further calls once the budget is spent (0 disables the guard).
FIQ_PROVIDER_OPENWEATHER_DAILY_BUDGET=1000

# Scheduler / worker tuning
FIQ_SCHEDULER_INTERVAL=15s
FIQ_SLOT_LEASE_DURATION=5m
FIQ_WORKER_MAX_CONCURRENT=8
# Per-job timeout (bounds one dispatched collection, incl. retries).
FIQ_WORKER_JOB_TIMEOUT=60s
# Graceful-shutdown drain deadline for in-flight jobs.
FIQ_SCHEDULER_DRAIN_TIMEOUT=30s
# How late a claim may be before a slot counts as a missed schedule
# (blank/0 → defaults to 2× the tick interval, floored at 2m).
FIQ_SCHEDULER_MISSED_THRESHOLD=

# Dev-mode admin token (development/test ONLY). Retained as a production
# safety guard (must be UNSET in production); it no longer grants admin access
# on its own — admin authorization is the real middleware (RequireAuth +
# RequireRole("admin")) resolving the bootstrap-admin user below.
FIQ_DEV_ADMIN_TOKEN=dev-admin-token

# Authentication (ADR-008 Supabase Auth / JWKS; WP-03/WP-19).
# In non-production, FIQ_AUTH_DEV_MODE defaults to true and the local dev token
# verifier is used (token format "<subject>" or "<subject>:<email>"); the dev
# verifier is compiled out of release builds. In production set dev-mode false
# and provide the Supabase JWKS URL (issuer/audience optional but recommended).
FIQ_AUTH_DEV_MODE=true
FIQ_AUTH_JWKS_URL=
FIQ_AUTH_ISSUER=
FIQ_AUTH_AUDIENCE=

# Bootstrap admin (ADR-017 "first account seeded admin"). The auth subject seed
# promotes/provisions to role=admin so the operator surface is reachable. In
# dev-mode the subject is the dev token prefixed with "dev|" (e.g. the bearer
# "admin" -> subject "dev|admin"); in production it is the Supabase user id.
# Leave the subject empty to seed no admin (promote later out of band).
FIQ_BOOTSTRAP_ADMIN_SUBJECT=dev|admin
FIQ_BOOTSTRAP_ADMIN_EMAIL=admin@forecastiq.local

# Rate limiting (in-process token bucket)
FIQ_RATE_LIMIT_PER_IP_PER_MIN=120

# CORS allowlist (comma-separated origins)
FIQ_CORS_ALLOW_ORIGINS=http://localhost:3000
