# ForecastIQ — Terraform Variables Template
# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars (it is gitignored).
#
# Secrets can alternatively be supplied via environment variables:
#   export TF_VAR_cloudflare_api_token="..."

# Cloudflare — create an API token with DNS:Edit permission for your zone.
cloudflare_api_token = "REPLACE_ME"
cloudflare_zone_id   = "REPLACE_ME"

# Elastic IP of the ForecastIQ EC2 instance (from the instances TF project).
vps_ip = "203.0.113.1"

# Base domain (without subdomain prefix)
domain = "forecastiq.example"
